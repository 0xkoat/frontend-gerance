# Copy to .env.local (gitignored) and fill in for local dev.

# Server-only — never prefix with NEXT_PUBLIC_, this must not reach the browser bundle.
# Backend defaults to PORT=3000 when unset (see backend/src/main.ts), which collides with
# Next's own default dev port. `npm run dev` in this project runs on 3001 to avoid that
# (see the -p 3001 in package.json) — adjust both if you change either side's port.
BACKEND_URL=http://localhost:3000/api